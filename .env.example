AHOLO_API_KEY=your_api_key_here
AHOLO_REGION=cn

# Optional: also listen on this machine's exact Tailscale IP (default port 4100).
# DASH_TAILSCALE_IP=100.90.10.20
# Optional exact MagicDNS names for this same node, comma-separated:
# DASH_TAILSCALE_HOSTNAMES=my-node,my-node.example-tailnet.ts.net

# Optional Docker / remote-host / reverse-proxy deployment overrides (used by compose.yaml):
# DASH_BIND_HOST=0.0.0.0
# DASH_ALLOW_REMOTE_PEERS=1
# DASH_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,my-node.example-tailnet.ts.net

# Optional Admin auth key (if omitted, server auto-generates data/private/admin-token):
# DASH_ADMIN_KEY=replace_with_long_random_admin_key
# Optional exact public HTTPS origins (reverse-proxy / showcase domain, comma-separated, no paths):
# DASH_PUBLIC_ORIGINS=https://home.example.com
