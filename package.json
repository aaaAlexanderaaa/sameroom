{
  "name": "sameroom",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1 --port 5173 --strictPort\"",
    "build": "npm run typecheck && vite build && tsx scripts/check-bundle.ts",
    "preview": "npm run start",
    "typecheck": "tsc --noEmit",
    "lux3d": "tsx scripts/lux3d.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build && npm run test:e2e",
    "assets:prepare": "tsx scripts/prepare-assets.ts",
    "predev": "npm run assets:prepare",
    "prebuild": "npm run assets:prepare",
    "fixture": "tsx scripts/fixture.ts",
    "start": "tsx server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "home": "tsx scripts/home.ts",
    "public:prepare": "tsx scripts/prepare-public.ts",
    "format": "prettier --write src server shared scripts tests *.json *.ts *.html examples"
  },
  "dependencies": {
    "@manycore/aholo-sdk-lux3d": "1.9.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xyflow/react": "12.12.1",
    "commander": "15.1.0",
    "dotenv": "18.0.10",
    "elkjs": "0.12.1",
    "express": "5.3.0",
    "lucide-react": "1.72.0",
    "multer": "2.5.0",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "three": "0.187.0",
    "uuid": "14.0.3",
    "write-file-atomic": "7.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/write-file-atomic": "4.0.3",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "prettier": "3.10.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
